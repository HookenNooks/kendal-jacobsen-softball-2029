---
pagination:
  data: players
  size: 1
  alias: p
permalink: "/{{ p.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ p.name }} · Softball · Class of {{ p.grad_year }}"
  description: "{{ p.name }}, class of {{ p.grad_year }}{% if p.positions %}, {{ p.positions }}{% endif %}{% if p.club_team %}, {{ p.club_team }}{% endif %}. Highlights, stats, schedule and contact."
  previewImage: "{% if p.photo %}/assets/photos/{{ p.photo }}{% endif %}"
  noindex: "{% if not p.searchable or not p.published %}true{% endif %}"
---
{% if not p.published %}<div class="draft">Draft preview: not on the live site (published: false)</div>{% endif %}

<header class="hero{% if not p.photo %} no-photo{% endif %}">
  {% if p.photo %}
  <img class="hero-photo" src="/assets/photos/{{ p.photo }}" alt="{{ p.photo_alt or p.name }}" width="1080" height="1350" fetchpriority="high">
  {% endif %}
  <div class="hero-shade" aria-hidden="true"></div>
  {% if p.club_jersey %}<div class="hero-num" aria-hidden="true">{{ p.club_jersey }}</div>{% endif %}
  <div class="wrap hero-content">
    <p class="eyebrow">Class of {{ p.grad_year }}{% if p.positions %}<span class="dot">·</span>{{ p.positions }}{% endif %}</p>
    <h1><span class="first">{{ p.firstName }}</span> <span class="last">{{ p.lastName }}</span></h1>
    <p class="hero-meta">{{ [p.club_team, ("#" + p.club_jersey) if p.club_jersey else ""] | select | join(" · ") }}</p>
    {% if p.headline %}<p class="headline">{{ p.headline }}</p>{% endif %}
    <p class="hero-actions">
      {% if p.mainEmail %}
      {% set e = p.mainEmail | emailParts %}
      <a class="btn btn-gold js-email" href="#contact" data-u="{{ e.user }}" data-d="{{ e.domain }}">Email {{ p.firstName }}</a>
      {% endif %}
      {% if p.video.youtube or p.video.link %}<a class="btn btn-ghost" href="#video">Watch video</a>{% endif %}
    </p>
  </div>
</header>

{% if (p.spotlight | length) or p.video.youtube or p.video.link %}
<div class="showcase">
  <div class="wrap">
    {% if p.spotlight | length %}
    <div class="spotlight">
      <dl>
        {% for item in p.spotlight %}<div><dd>{{ item[1] }}</dd><dt>{{ item[0] }}</dt></div>{% endfor %}
      </dl>
      <p class="spotlight-note">{{ p.spotlightGroup }}</p>
    </div>
    {% endif %}

    {% if p.video.youtube or p.video.link %}
    <section id="video" class="video-wrap" aria-label="Highlight video">
      {% if p.video.youtube %}
      <button class="video js-video" type="button" data-id="{{ p.video.youtube }}" aria-label="Play highlight video">
        <img src="https://i.ytimg.com/vi/{{ p.video.youtube }}/hqdefault.jpg" alt="" loading="lazy" width="480" height="360">
        <span class="play" aria-hidden="true"></span>
        <span class="video-label">Highlights</span>
      </button>
      {% endif %}
      {% if p.video.link %}<p><a class="btn btn-ghost" href="{{ p.video.link }}" rel="noopener">More video</a></p>{% endif %}
    </section>
    {% endif %}
  </div>
</div>
{% endif %}

<main class="wrap">

  {% set basics = [
    ["Grad year", p.grad_year],
    ["Position", p.positions],
    ["Bats / Throws", [p.bats, p.throws] | select | join(" / ")],
    ["Height", p.height],
    ["High school", p.high_school],
    ["High school jersey", ("#" + p.hs_jersey) if p.hs_jersey else ""],
    ["Club team", p.club_team],
    ["Club jersey", ("#" + p.club_jersey) if p.club_jersey else ""]
  ] %}
  <section>
    <h2>Player profile</h2>
    <dl class="facts">
      {% for row in basics %}{% if row[1] %}
      <div><dt>{{ row[0] }}</dt><dd>{{ row[1] }}</dd></div>
      {% endif %}{% endfor %}
    </dl>
  </section>

  {% if p.gpa or (p.tests | length) %}
  <section>
    <h2>Academics</h2>
    <dl class="facts">
      {% if p.gpa %}<div><dt>GPA</dt><dd>{{ p.gpa }}{% if p.gpa_note %} <small>{{ p.gpa_note }}</small>{% endif %}</dd></div>{% endif %}
      {% for test, score in p.tests %}<div><dt>{{ test }}</dt><dd>{{ score }}</dd></div>{% endfor %}
    </dl>
  </section>
  {% endif %}

  {% if p.stats | length %}
  <section>
    <h2>Stats</h2>
    {% if p.stats_note or p.stats_as_of %}
    <p class="muted section-note">{{ p.stats_note }}{% if p.stats_note and p.stats_as_of %} · {% endif %}{% if p.stats_as_of %}as of {{ p.stats_as_of | longDate }}{% endif %}</p>
    {% endif %}
    {% for group, items in p.stats %}
    <h3>{{ group }}</h3>
    <dl class="stats">
      {% for label, value in items %}<div><dd>{{ value }}</dd><dt>{{ label }}</dt></div>{% endfor %}
    </dl>
    {% endfor %}
  </section>
  {% endif %}

  {% if p.schedule | length %}
  <section class="js-schedule">
    <h2>Where to see her play</h2>
    <ul class="events">
      {% for e in p.schedule %}
      <li class="event{% if e.featured %} featured{% endif %}" data-end="{{ e.end }}">
        {% if e.logo %}<img class="event-logo" src="/assets/logos/{{ e.logo }}" alt="" width="64" height="64" loading="lazy">{% endif %}
        <div class="event-info">
          {% if e.featured %}<span class="tag">Featured event</span>{% endif %}
          <strong>{{ e.name }}</strong>
          <span class="event-date">{{ e.start | dateRange(e.end) }}</span>
          <span class="muted">{{ [e.location, (e.division + " division") if e.division else ""] | select | join(" · ") }}</span>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

</main>

{% if (p.contact | length) or (p.links | length) %}
<div class="closing" id="contact">
  <div class="wrap">
    <h2>Get in touch</h2>
    {% if p.contact | length %}
    <ul class="contact">
      {% for label, email in p.contact %}
      {% set e = email | emailParts %}
      <li><span class="contact-label">{{ label }}</span>
        <a class="js-email" href="#contact" data-u="{{ e.user }}" data-d="{{ e.domain }}">{{ e.user }} [at] {{ e.domain }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if p.links | length %}
    <h3>Recruiting profiles</h3>
    <p class="links">
      {% for label, url in p.links %}<a class="btn btn-ghost" href="{{ url }}" rel="noopener">{{ label }}</a>{% endfor %}
    </p>
    {% endif %}
  </div>
</div>
{% endif %}

<footer class="wrap">Updated {{ p.updated | longDate }}</footer>

<script>
// Build email links in the browser so the page source has no plain addresses.
document.querySelectorAll(".js-email").forEach(function (a) {
  var addr = a.dataset.u + "@" + a.dataset.d;
  a.href = "mailto:" + addr;
  if (a.textContent.indexOf("[at]") !== -1) a.textContent = addr;
});
// Load YouTube only when tapped, so the page stays fast.
document.querySelectorAll(".js-video").forEach(function (b) {
  b.addEventListener("click", function () {
    var f = document.createElement("iframe");
    f.src = "https://www.youtube-nocookie.com/embed/" + b.dataset.id + "?autoplay=1&playsinline=1&rel=0";
    f.title = "Highlight video";
    f.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    f.allowFullscreen = true;
    f.className = "video";
    b.replaceWith(f);
  });
});
// Hide tournaments that ended since the last update.
(function () {
  var today = new Date().toISOString().slice(0, 10);
  document.querySelectorAll(".event").forEach(function (li) {
    if (li.dataset.end < today) li.remove();
  });
  var s = document.querySelector(".js-schedule");
  if (s && !s.querySelector(".event")) s.remove();
})();
</script>
